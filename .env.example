# Storage backend, picked in this order: GCS_BUCKET, then
# AZURE_STORAGE_CONNECTION_STRING, then local disk under
# ./data/materials. GCS taking precedence means you can set it while the
# Azure values are still present and cut over without editing anything
# else.
GCS_BUCKET=
# Optional: namespace keys inside a shared bucket, e.g. GCS_PREFIX=guru
GCS_PREFIX=

AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=materials

# Database. Unset means a local SQLite file under APP_DATA_DIR, which is
# fine on a VM but NOT on Cloud Run - instances are ephemeral, so the
# file goes away with them. Point this at Cloud SQL there.
#   DATABASE_URL=postgresql://user:pass@/dbname?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Where the SQLite database and (if using local storage) uploaded files
# are kept, when running the app directly on a machine (not in Docker).
# Leave this OUT of your .env when running via docker-compose - the
# compose files force APP_DATA_DIR=/app/data themselves, matching the
# persistent volume. Setting it here too would just be overridden.
# APP_DATA_DIR=data

# LLM for the tutor. Vertex AI is used when GOOGLE_CLOUD_PROJECT is set,
# authenticating as the service account the app already runs as - no API
# key to manage. It takes precedence over the Azure settings below, so
# both can coexist during a migration.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
# VERTEX_MODEL=google/gemini-2.5-flash

# Azure AI Foundry - the previous provider, still supported. Create a resource + a model deployment
# in Azure AI Foundry first (works with any chat model in its catalog,
# not just OpenAI's - e.g. Kimi K2). Without these set,
# /api/subjects/{id}/chat returns a 503 - everything else works fine
# without them.
#
# AZURE_OPENAI_ENDPOINT: the deployment's "Endpoint" value from its
# Details page in Azure AI Foundry, WITHOUT the trailing
# /chat/completions (the SDK appends that itself) - e.g.
#   https://<your-resource>.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT: the deployment's "Name" from that same page
# (e.g. Kimi-K2.6) - not the underlying model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# How many materials may be processed at once. Each one holds its file
# in memory several times over (raw bytes, pages, chunks, embeddings,
# decoded figures), so this is the main lever on peak memory. Raising it
# speeds up bulk uploads but risks the container being OOM-killed, which
# strands materials in "processing" - lower it before lowering memory.
#
# Budget this against RERANKER_ENABLED: the cross-encoder stays resident
# once a chat request loads it (~1.1GB), and it shares the instance with
# uploads. A value tuned with the reranker off will OOM once it is on.
# The deployment runs 1 against 8Gi.
# MAX_CONCURRENT_PROCESSING=1

# Figure selection. A figure is shown when its caption both clears
# TUTOR_MIN_IMAGE_SCORE (a low absolute floor) and beats the subject's
# median caption score by TUTOR_IMAGE_MARGIN - i.e. it stands out rather
# than hitting a fixed number, since absolute cosine values vary by
# embedding model. Raise the margin if unrelated diagrams appear, lower
# it if figures rarely show up.
# Inspect real scores with: GET /api/subjects/{id}/figures?q=your+question
# TUTOR_MIN_IMAGE_SCORE=0.20
# TUTOR_IMAGE_MARGIN=0.08
# TUTOR_IMAGE_KEEP_RATIO=0.85
# TUTOR_MAX_IMAGES=3
# Cross-encoder relevance probability a figure must reach to be shown.
# Meaningful on its own, unlike a cosine cutoff, because the model is
# trained to answer "is this relevant to this query".
# TUTOR_RERANK_MIN_SCORE=0.30
# Retrieval pipeline. Stage 1 fuses dense vector search with BM25 via
# weighted Reciprocal Rank Fusion; stage 2 reranks the shortlist with a
# cross-encoder. BM25 is weighted above dense because the embedding is a
# paraphrase model and unreliable on exact terms.
# RETRIEVAL_RRF_K=20
# RETRIEVAL_DENSE_WEIGHT=1.0
# RETRIEVAL_SPARSE_WEIGHT=2.0
# RETRIEVAL_SPARSE_MIN_RATIO=0.1
#
# Cross-encoder reranking. OFF by default: the model needs well over a
# gigabyte resident, and on a small VM with no swap that is enough to
# take the whole host down rather than just the app. Enable only with
# memory to spare (roughly 2GB free beyond the app), and watch
# `docker stats` after the first question.
# RERANKER_ENABLED=1
# RERANKER_MODEL=jinaai/jina-reranker-v2-base-multilingual
# RERANKER_CANDIDATES=10
# RERANKER_THREADS=1
# EMBEDDING_THREADS=1

# Text recognition for scanned/handwritten pages. Only pages with no text
# layer are sent (see SCAN_TEXT_FLOOR); everything else uses the text
# already in the file, which is exact and free. Recognition runs through
# the same Vertex model as the tutor, so there is no second provider to
# configure. Results are cached in storage against the file's content
# hash, so reprocessing a subject does not pay for the pages again.
# OCR_ENABLED=1
# OCR_DPI=150
# OCR_MAX_PAGES=80
# OCR_CONCURRENCY=4

# How much to lift a recognised chunk's dense-retrieval vote. BM25 is
# weighted above dense matching because it nails exact terms - which is
# exactly what recognition gets wrong - so recognised text never earns the
# lexical vote its native neighbours do. A starting point, not a measured
# optimum. No effect on subjects without recognised text.
# RETRIEVAL_OCR_DENSE_BOOST=1.5

# Material processing runs in a separate Cloud Run job rather than inside
# the request that uploaded the file: an instance can be reclaimed or
# OOM-killed at any moment, and the work vanished with it. Set this to the
# job's name to hand work off; leave it unset (local dev, docker compose)
# and processing happens in-process as before.
# PROCESSING_JOB=guru-process
# PROCESSING_JOB_REGION=us-central1
#
# How long a claimed material may sit unfinished before another worker
# assumes the one holding it died and requeues it. Must comfortably exceed
# the slowest realistic material, so a slow job is never stolen from
# itself.
# PROCESSING_STALE_MINUTES=45
# Attempts before a material that keeps killing workers is failed for
# good, rather than retried forever.
# PROCESSING_MAX_ATTEMPTS=3
# How long a worker keeps looking for new work before exiting, so an
# upload burst is absorbed by one execution instead of one cold start each.
# PROCESSING_LINGER_SECONDS=20

# Sign-in, via Google Identity Platform. The web API key is a public
# project identifier rather than a secret: access is governed by the
# authorised-domain list and by the server verifying every token.
# IDENTITY_API_KEY=
# IDENTITY_AUTH_DOMAIN=<project>.firebaseapp.com
#
# Emails allowed to add to the shared library. Everyone else can upload
# only for themselves.
# ADMIN_EMAILS=you@example.com
#
# Skips sign-in entirely and treats every request as one local developer.
# For running the app on your own machine, where there is no Identity
# Platform to verify against. Never set this on anything reachable.
# AUTH_DISABLED=1
