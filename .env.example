# Leave AZURE_STORAGE_CONNECTION_STRING unset to store materials on local
# disk under ./data/materials (useful for local development). Set it to
# point uploads at Azure Blob Storage instead - no code changes needed.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=materials

# Where the SQLite database and (if using local storage) uploaded files
# are kept, when running the app directly on a machine (not in Docker).
# Leave this OUT of your .env when running via docker-compose - the
# compose files force APP_DATA_DIR=/app/data themselves, matching the
# persistent volume. Setting it here too would just be overridden.
# APP_DATA_DIR=data

# Azure AI Foundry - powers the actual tutor (chat grounded in a
# subject's retrieved material). Create a resource + a model deployment
# in Azure AI Foundry first (works with any chat model in its catalog,
# not just OpenAI's - e.g. Kimi K2). Without these set,
# /api/subjects/{id}/chat returns a 503 - everything else works fine
# without them.
#
# AZURE_OPENAI_ENDPOINT: the deployment's "Endpoint" value from its
# Details page in Azure AI Foundry, WITHOUT the trailing
# /chat/completions (the SDK appends that itself) - e.g.
#   https://<your-resource>.services.ai.azure.com/openai/v1
# AZURE_OPENAI_DEPLOYMENT: the deployment's "Name" from that same page
# (e.g. Kimi-K2.6) - not the underlying model name.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=

# Figure selection. A figure is shown when its caption both clears
# TUTOR_MIN_IMAGE_SCORE (a low absolute floor) and beats the subject's
# median caption score by TUTOR_IMAGE_MARGIN - i.e. it stands out rather
# than hitting a fixed number, since absolute cosine values vary by
# embedding model. Raise the margin if unrelated diagrams appear, lower
# it if figures rarely show up.
# Inspect real scores with: GET /api/subjects/{id}/figures?q=your+question
# TUTOR_MIN_IMAGE_SCORE=0.20
# TUTOR_IMAGE_MARGIN=0.08
# TUTOR_IMAGE_KEEP_RATIO=0.85
# TUTOR_MAX_IMAGES=3
